---
import Section from "./Section.astro";

const offerings = [
    {
        title: "Developer Productivity Audits & Implementation",
        body: "Find where engineering time leaks out through slow builds, brittle environments, and manual toil, then fix it.",
    },
    {
        title: "Build System & Toolchain Migrations",
        body: "Move teams off legacy build tooling (Ant, Maven, aging Gradle setups) without stalling delivery mid-migration.",
    },
    {
        title: "Internal Developer Platform Design & Delivery",
        body: "Design and ship the internal tools, devcontainers, and platform surfaces engineers actually want to use, not the ones they’re forced to.",
    },
];
---

<Section id="what-i-do" index={1} title="What I Do" width="wide">
    <div
        class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-line border-y border-line"
    >
        {
            offerings.map(({ title, body }) => (
                <div class="py-8 md:py-10 md:px-8 lg:px-10 md:first:pl-0 md:last:pr-0">
                    <h3 class="font-display text-lg font-semibold text-ink leading-tight mb-3">
                        {title}
                    </h3>
                    <p class="text-sm sm:text-[15px] text-graphite leading-relaxed">
                        {body}
                    </p>
                </div>
            ))
        }
    </div>

    <p
        class="text-[13.5px] sm:text-[15px] text-graphite leading-relaxed max-w-[720px] italic"
    >
        While these are my main focus areas, I'm also open to broader senior
        engineering work — like architecture reviews, technical due diligence,
        or complex systems problems that don't fit a clean category. If you have
        a unique challenge in mind, I'd love to chat.
    </p>
</Section>
