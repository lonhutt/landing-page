---
/**
 * Tangled build pipelines resolving into one clean stream.
 *
 * The two variants below are the same drawing at two aspect ratios — the
 * mobile one is a tighter crop with heavier strokes so it stays legible at
 * small widths. Colors come from the theme tokens in global.css.
 */
interface Variant {
    /** Responsive visibility for this variant. */
    show: string;
    viewBox: string;
    dotOpacity: number;
    dots: [number, number][];
    labelClass: string;
    labelOpacity: number;
    labels: { x: number; y: number; text: string }[];
    traceWidth: number;
    /** Tangled input paths, drawn in sequence. */
    paths: { d: string; delay: number; opacity?: number; width?: number }[];
    junction: { cx: number; cy: number; r: number; width: number };
    signal: {
        x1: number;
        x2: number;
        y: number;
        width: number;
        nodeR: number;
        ringR: number;
        ringWidth: number;
    };
}

const variants: Variant[] = [
    {
        show: "block sm:hidden",
        viewBox: "0 0 340 76",
        dotOpacity: 0.4,
        dots: [
            [8, 20],
            [8, 40],
            [8, 60],
            [85, 20],
            [85, 60],
            [165, 40],
            [245, 40],
            [324, 40],
        ],
        labelClass:
            "font-mono text-[9px] tracking-wider fill-graphite font-medium",
        labelOpacity: 0.85,
        labels: [
            { x: 8, y: 11, text: "LEGACY TOOLING" },
            { x: 214, y: 25, text: "OPTIMIZED PIPELINE" },
        ],
        traceWidth: 2,
        paths: [
            {
                d: "M 8 20 C 45 20, 40 60, 80 60 C 120 60, 125 22, 145 22 C 155 22, 160 38, 165 40",
                delay: 0,
            },
            {
                d: "M 8 40 C 35 40, 50 18, 75 28 C 100 38, 115 62, 140 54 C 152 50, 158 42, 165 40",
                delay: 80,
            },
            {
                d: "M 8 60 C 45 60, 50 20, 90 20 C 125 20, 125 60, 145 60 C 155 60, 160 42, 165 40",
                delay: 160,
            },
            {
                d: "M 8 30 C 40 30, 75 64, 110 44 C 135 30, 150 40, 165 40",
                delay: 220,
                opacity: 0.6,
                width: 1.5,
            },
        ],
        junction: { cx: 165, cy: 40, r: 4.5, width: 2 },
        signal: {
            x1: 169,
            x2: 324,
            y: 40,
            width: 3,
            nodeR: 5,
            ringR: 9,
            ringWidth: 1.2,
        },
    },
    {
        show: "hidden sm:block",
        viewBox: "0 0 720 96",
        dotOpacity: 0.35,
        dots: [
            [24, 24],
            [24, 48],
            [24, 72],
            [160, 24],
            [160, 72],
            [340, 48],
            [520, 48],
            [696, 48],
        ],
        labelClass: "font-mono text-[10px] tracking-wider fill-graphite",
        labelOpacity: 0.75,
        labels: [
            { x: 24, y: 14, text: "LEGACY TOOLING / SLOW BUILDS" },
            { x: 510, y: 32, text: "OPTIMIZED PIPELINE" },
        ],
        traceWidth: 1.5,
        paths: [
            {
                d: "M 24 24 C 90 24, 80 72, 150 72 C 220 72, 210 24, 280 24 C 330 24, 350 48, 380 48",
                delay: 0,
            },
            {
                d: "M 24 48 C 70 48, 100 20, 140 36 C 180 52, 210 80, 260 64 C 310 48, 340 48, 380 48",
                delay: 80,
            },
            {
                d: "M 24 72 C 90 72, 100 28, 170 28 C 240 28, 230 72, 290 72 C 340 72, 355 48, 380 48",
                delay: 160,
            },
            {
                d: "M 24 36 C 60 36, 120 78, 180 50 C 240 22, 280 48, 380 48",
                delay: 220,
                opacity: 0.6,
            },
        ],
        junction: { cx: 380, cy: 48, r: 4, width: 1.5 },
        signal: {
            x1: 384,
            x2: 696,
            y: 48,
            width: 2.5,
            nodeR: 4.5,
            ringR: 8,
            ringWidth: 1,
        },
    },
];
---

<div
    class="w-full select-none py-1 sm:py-2"
    aria-label="Schematic diagram: tangled build pipelines resolving into a single clean stream"
    role="img"
>
    {
        variants.map((v) => (
            <svg
                viewBox={v.viewBox}
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class:list={[v.show, "w-full h-auto overflow-visible"]}
            >
                {/* Schematic grid dots / background reference */}
                <g opacity={v.dotOpacity} class="fill-line">
                    {v.dots.map(([cx, cy]) => (
                        <circle cx={cx} cy={cy} r="1.5" />
                    ))}
                </g>

                <g class={v.labelClass} opacity={v.labelOpacity}>
                    {v.labels.map(({ x, y, text }) => (
                        <text x={x} y={y}>
                            {text}
                        </text>
                    ))}
                </g>

                {/* Tangled input paths */}
                <g
                    class="stroke-line"
                    stroke-width={v.traceWidth}
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                >
                    {v.paths.map(({ d, delay, opacity, width }) => (
                        <path
                            d={d}
                            class="animate-schematic-trace"
                            opacity={opacity}
                            stroke-width={width}
                            style={{ animationDelay: `${delay}ms` }}
                        />
                    ))}
                </g>

                {/* Junction / convergence ring */}
                <circle
                    cx={v.junction.cx}
                    cy={v.junction.cy}
                    r={v.junction.r}
                    stroke-width={v.junction.width}
                    class="fill-paper stroke-line animate-schematic-trace"
                />

                {/* Resolved straight line */}
                <g
                    class="animate-schematic-signal"
                    style={{ animationDelay: "300ms" }}
                >
                    <line
                        x1={v.signal.x1}
                        y1={v.signal.y}
                        x2={v.signal.x2}
                        y2={v.signal.y}
                        class="stroke-signal"
                        stroke-width={v.signal.width}
                        stroke-linecap="round"
                    />

                    {/* Clean terminal node */}
                    <circle
                        cx={v.signal.x2}
                        cy={v.signal.y}
                        r={v.signal.nodeR}
                        class="fill-signal"
                    />

                    {/* Pulse ring indicator */}
                    <circle
                        cx={v.signal.x2}
                        cy={v.signal.y}
                        r={v.signal.ringR}
                        fill="none"
                        class="stroke-signal"
                        stroke-width={v.signal.ringWidth}
                        opacity="0.4"
                    />
                </g>
            </svg>
        ))
    }
</div>
