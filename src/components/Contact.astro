---
import { Icon } from "astro-icon/components";
import Section from "./Section.astro";
import BookCall from "./BookCall.astro";

const links = [
    { href: "mailto:lon@lonhutt.com", icon: "lucide:mail", label: "lon@lonhutt.com" },
    {
        href: "https://www.linkedin.com/in/lon-hutt/",
        icon: "simple-icons:linkedin",
        label: "LinkedIn",
        external: true,
    },
    {
        href: "https://github.com/lonhutt",
        icon: "simple-icons:github",
        label: "GitHub",
        external: true,
    },
];
---

<Section id="book-a-call" index={4} title="Contact" last>
    <div class="space-y-8">
        <div
            class="flex flex-col sm:flex-row flex-wrap sm:items-center gap-x-10 gap-y-5 font-mono text-sm"
        >
            {
                links.map(({ href, icon, label, external }) => (
                    <a
                        href={href}
                        target={external ? "_blank" : undefined}
                        rel={external ? "noopener noreferrer" : undefined}
                        class="inline-flex items-center gap-2.5 text-ink hover:text-signal-ink transition-colors group"
                    >
                        <Icon
                            name={icon}
                            class="w-4 h-4 text-graphite group-hover:text-signal-ink transition-colors"
                        />
                        <span class="underline underline-offset-4 decoration-line group-hover:decoration-signal-ink">
                            {label}
                        </span>
                    </a>
                ))
            }
        </div>

        <div class="pt-2">
            <BookCall />
        </div>
    </div>
</Section>
