---
import Section from "./Section.astro";

const caseStudy = [
    {
        label: "Problem",
        body: "A large SaaS engineering org’s monolith team had onboarding times measured in days, not hours.",
    },
    {
        label: "What I did",
        body: "Designed and built the team’s remote development environment from scratch.",
    },
    {
        label: "Outcome",
        body: "New engineers were productive same-day.",
        accent: true,
    },
];
---

<Section id="recent-work" index={2} title="Recent Work">
    <article class="border border-line/80 bg-paper/50 p-6 sm:p-8 space-y-5">
        {
            caseStudy.map(({ label, body, accent }, i) => (
                <>
                    {i > 0 && <div class="h-px w-full bg-line/50" />}
                    <div>
                        <span
                            class:list={[
                                "font-mono text-[11px] font-bold uppercase tracking-wider block mb-1.5",
                                accent ? "text-signal-ink" : "text-graphite",
                            ]}
                        >
                            {label}
                        </span>
                        <p
                            class:list={[
                                "text-ink text-[15px] leading-relaxed",
                                accent && "font-semibold",
                            ]}
                        >
                            {body}
                        </p>
                    </div>
                </>
            ))
        }
    </article>
</Section>
