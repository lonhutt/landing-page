---
import { Font } from "astro:assets";

import "../styles/global.css";

const title =
    "Lon Hutt — Developer Productivity & Internal Platforms Consultant";
const description =
    "I'm a Principal engineer who fixes broken developer experience — I speed up your builds, migrate you off legacy tooling, and build the internal platforms your engineers actually want to use.";
const socialDescription =
    "I speed up your builds, migrate you off legacy tooling, and build the internal platforms your engineers actually want to use.";

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Lon Hutt",
    url: Astro.site?.href,
    jobTitle: "Principal Engineer",
    email: "mailto:lon@lonhutt.com",
    description: socialDescription,
    knowsAbout: [
        "Developer productivity",
        "Internal developer platforms",
        "Build systems",
        "Toolchain migrations",
    ],
    address: {
        "@type": "PostalAddress",
        addressLocality: "Denver",
        addressRegion: "CO",
        addressCountry: "US",
    },
    sameAs: [
        "https://www.linkedin.com/in/lon-hutt/",
        "https://github.com/lonhutt",
    ],
};
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={socialDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content="Lon Hutt" />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Lon Hutt — Developer Productivity & Internal Platforms Consultant"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImage} />

        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

        {/* Italic is one paragraph far below the fold — load it, don't preload it. */}
        <Font cssVariable="--font-inter" preload={[{ style: "normal" }]} />
        <Font cssVariable="--font-space-grotesk" preload />
        <Font cssVariable="--font-jetbrains-mono" preload />

        <meta name="generator" content={Astro.generator} />
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(personSchema)}
        />
    </head>
    <body>
        <a href="#main" class="skip-link">Skip to content</a>
        <div class="min-h-screen relative overflow-x-hidden">
            {/* Background Grid Texture */}
            <div
                class="fixed inset-0 pointer-events-none z-0 opacity-40 mix-blend-multiply"
                style="background-image: linear-gradient(to right, var(--color-line) 1px, transparent 1px), linear-gradient(to bottom, var(--color-line) 1px, transparent 1px); background-size: 32px 32px;"
                aria-hidden="true"
            >
            </div>
            <main id="main">
                <slot />
            </main>
        </div>
    </body>
</html>
